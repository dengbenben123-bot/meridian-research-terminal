# The default GitHub workflow needs only CLOUDFLARE_API_TOKEN in repository Secrets.
# It prepares other settings automatically. See DEPLOY.md.
# The optional metadata below is only for npm run deploy:manual.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=meridian-files
PUBLIC_ORIGIN=https://meridian-research-terminal.cooked-jersey.workers.dev
TURNSTILE_SITE_KEY=
# For the advanced manual command, provide the three private values through your environment.
# No credential belongs in this file.
