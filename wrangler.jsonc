{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"meridian-research-terminal",
  "main":"src/api/index.ts",
  "compatibility_date":"2026-10-29",
  "compatibility_flags":["nodejs_compat"],
  "keep_vars":true,
  "workers_dev":true,
  "preview_urls":false,
  "assets":{"directory":"dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/media/*","/healthz"]},
  "d1_databases":[{"binding":"DB","database_name":"meridian-platform","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"FILES","bucket_name":"meridian-files"}],
  "ratelimits":[{"name":"AUTH_LIMITER","namespace_id":"61001","simple":{"limit":10,"period":60}},{"name":"WRITE_LIMITER","namespace_id":"61002","simple":{"limit":30,"period":60}},{"name":"READ_LIMITER","namespace_id":"61003","simple":{"limit":60,"period":60}}],
  "vars":{"APP_ENV":"production","PUBLIC_ORIGIN":"https://meridian-research-terminal.cooked-jersey.workers.dev","TURNSTILE_SITE_KEY":""},
  "observability":{"enabled":false}
}
